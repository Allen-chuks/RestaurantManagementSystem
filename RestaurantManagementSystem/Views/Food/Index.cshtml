@model IEnumerable<RestaurantManagementSystem.Models.FoodItem>

@{
    ViewData["Title"] = "Food Menu";
}

<h2 class="mb-4">Food Menu</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="~/@item.ImagePath" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;" />
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">Price: @item.Price.ToString("C")</p>
                    <p class="text-muted">@(item.IsAvailable ? "Available" : "Not Available")</p>
                </div>
            </div>
        </div>
    }
</div>
