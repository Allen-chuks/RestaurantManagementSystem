@model IEnumerable<RestaurantManagementSystem.Models.FoodItem>

@{
    ViewData["Title"] = "Menu";
}

<h1>Menu</h1>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 text-center mb-4">
            <div class="card">
                <img class="card-img-top" src="~/@item.ImagePath" alt="@item.Name" style="height:200px;object-fit:cover;" />
                <div class="card-body">
                    <h4 class="card-title">@item.Name</h4>
                    <p class="card-text">@item.Category</p>
                    <p class="card-text">$@item.Price</p>
                </div>
            </div>
        </div>
    }
</div>
